<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pidev.Controllers.client.User.AIAvatarCaptureController">
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Générateur d'Avatar IA" />
        <Label fx:id="statusLabel" text="Placez votre visage devant la caméra pour l'analyse..." style="-fx-text-fill: #64748b;" />
        
        <StackPane>
            <ImageView fx:id="cameraView" fitHeight="300.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" />
            <ProgressIndicator fx:id="loadingSpinner" visible="false" maxHeight="50" maxWidth="50" />
        </StackPane>
        
        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="captureBtn" onAction="#handleCaptureAndGenerate" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="Capturer et Générer" />
            <Button fx:id="cancelBtn" onAction="#handleCancel" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="Annuler" />
        </HBox>
    </children>
</VBox>
