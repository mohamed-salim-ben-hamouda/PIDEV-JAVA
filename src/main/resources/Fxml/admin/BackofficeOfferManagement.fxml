<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20.0" styleClass="content-page" stylesheets="@../../styles/management.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pidev.Controllers.admin.BackofficeOfferManagementController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-section">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="page-title" text="Gestion des Offres" />
                        <Label styleClass="page-subtitle" text="Administration des offres de recrutement." />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-bar">
            <children>
                <TextField fx:id="searchField" prefWidth="350.0" promptText="Rechercher une offre..." styleClass="search-input" />
                <FontIcon iconLiteral="fas-search" styleClass="search-icon" />
            </children>
        </HBox>

        <TableView fx:id="offerTable" prefHeight="400.0" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="titleCol" prefWidth="150.0" text="Titre" />
                <TableColumn fx:id="fieldCol" prefWidth="100.0" text="Domaine" />
                <TableColumn fx:id="typeCol" prefWidth="100.0" text="Type" />
                <TableColumn fx:id="locationCol" prefWidth="100.0" text="Lieu" />
                <TableColumn fx:id="statusCol" prefWidth="100.0" text="Statut" />
                <TableColumn fx:id="actionsCol" prefWidth="200.0" text="Actions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
